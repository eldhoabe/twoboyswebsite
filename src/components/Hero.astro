---
import { siteConfig, whatsappLink } from '../config/site';

// NOTE: using a plain <img> rather than astro:assets <Image> here.
// Image optimization for *remote* sources fetches the file at build
// time, which needs outbound network access to images.unsplash.com —
// not available in every build environment. If your deploy pipeline
// has that access, switch this back to <Image> for automatic
// resizing/format conversion, or better: download the photo into
// src/assets/ and import it locally, which Astro can always optimize.
const heroPhoto =
  'https://images.unsplash.com/photo-1605146769289-440113cc3d00?fm=jpg&q=80&w=1800&auto=format&fit=crop';
---
<section class="hero">
  <img
    class="hero-photo"
    src={heroPhoto}
    alt="A modern concrete house exterior, used here as a reference image"
    width="1800"
    height="1200"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="eyebrow fade">{siteConfig.location}</p>
    <h1 class="serif fade">
      Branded materials<br />for a home <em>built to last.</em>
    </h1>
    <p class="hero-sub fade">{siteConfig.description}</p>
    <div class="hero-cta fade">
      <a class="btn btn-primary" href="#catalog">See what we stock</a>
      <a class="btn btn-ghost" href={whatsappLink('Hi, I have a question about your building materials.')} target="_blank" rel="noopener">
        Chat on WhatsApp
      </a>
    </div>
    <div class="scroll-mark" aria-hidden="true"></div>
  </div>

  <p class="photo-credit">Photo: Dillon Kydd / Unsplash — reference only, swap for your own shop or project photos</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(36, 33, 28, 0.55),
      rgba(36, 33, 28, 0.35) 45%,
      rgba(36, 33, 28, 0.72)
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #fff;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(40px, 6.4vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    max-width: 900px;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    color: #e8b79a;
    font-weight: 300;
  }
  .hero-sub {
    max-width: 440px;
    margin: 30px auto 0;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.82);
  }
  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 42px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    font-size: 13px;
    letter-spacing: 0.5px;
    text-decoration: none;
    padding: 15px 30px;
    border-radius: 2px;
  }
  .btn-primary {
    background: #fff;
    color: var(--color-charcoal);
  }
  .btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .scroll-mark {
    margin-top: 80px;
    width: 1px;
    height: 60px;
    background: rgba(255, 255, 255, 0.35);
    position: relative;
    overflow: hidden;
  }
  .scroll-mark::after {
    content: '';
    position: absolute;
    top: -60px;
    left: 0;
    width: 1px;
    height: 60px;
    background: #fff;
    animation: drop 2.4s ease-in-out infinite;
  }
  @keyframes drop {
    to {
      top: 60px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-mark::after {
      animation: none;
      top: 0;
    }
  }
  .photo-credit {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.3px;
    z-index: 1;
  }
</style>
