---
import { siteConfig, whatsappLink } from '../config/site';
import StoreMap from './StoreMap.astro';
---
<section class="cta fade" id="visit" aria-labelledby="cta-heading">
  <p class="eyebrow">Visit the store</p>
  <h2 class="serif" id="cta-heading">
    Bring your list. We'll tell you exactly<br />what your home needs, stage by stage.
  </h2>
  <p class="cta-sub">
    Open {siteConfig.hours}, in {siteConfig.location}. Home and site delivery available across {siteConfig.serviceArea.join(', ')}.
  </p>
  <div class="cta-actions">
    <a class="btn btn-primary" href={whatsappLink('Hi, I would like to visit the store — what are your hours?')} target="_blank" rel="noopener">
      Chat on WhatsApp
    </a>
    <a class="btn btn-ghost" href={siteConfig.mapsUrl} target="_blank" rel="noopener">Get directions</a>
  </div>

  <StoreMap />
</section>

<style>
  .cta {
    padding: 140px 24px;
    text-align: center;
    border-top: 1px solid var(--color-hairline);
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0 0 28px;
  }
  h2 {
    font-size: clamp(32px, 4.6vw, 54px);
    font-weight: 300;
    max-width: 640px;
    margin: 0 auto;
  }
  .cta-sub {
    margin: 22px auto 0;
    max-width: 420px;
    color: var(--color-stone);
    font-size: 16px;
    line-height: 1.7;
  }
  .cta-actions {
    display: flex;
    gap: 16px;
    margin-top: 38px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    font-size: 13px;
    letter-spacing: 0.5px;
    text-decoration: none;
    padding: 15px 30px;
    border-radius: 2px;
  }
  .btn-primary {
    background: var(--color-charcoal);
    color: var(--color-cream);
  }
  .btn-ghost {
    border: 1px solid var(--color-hairline);
    color: var(--color-charcoal);
  }
</style>
