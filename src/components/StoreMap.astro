---
import { siteConfig, mapsEmbedUrl } from '../config/site';
---
<div class="store-map">
  <iframe
    src={mapsEmbedUrl()}
    title={`Map showing ${siteConfig.name} in Pathanamthitta`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

<style>
  .store-map {
    max-width: 640px;
    margin: 48px auto 0;
    border: 1px solid var(--color-hairline);
    /* Fixed aspect ratio keeps layout stable while the iframe loads
       lazily, avoiding a layout shift once it renders. */
    aspect-ratio: 16 / 9;
  }
  .store-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
